# Opcional: sem esta chave, o bot usa respostas prontas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

BOT_NAME=Ana
PRODUCT_NAME=Pequenos na Fé
PRODUCT_PRICE=R$ 17,90
CHECKOUT_URL=https://pay.cakto.com.br/vm7zb4r_1083277

# Identificador local da sessão. Não use espaços.
WHATSAPP_CLIENT_ID=pequenos-na-fe
SESSION_PATH=.wwebjs_auth
DATA_FILE=data/state.json

# Antispam
INBOUND_WINDOW_SECONDS=60
INBOUND_MAX_MESSAGES=8
INBOUND_BLOCK_MINUTES=5
INPUT_DEBOUNCE_SECONDS=8
OUTBOUND_CONTACT_COOLDOWN_SECONDS=25
OUTBOUND_GLOBAL_INTERVAL_MS=1500
HUMAN_DELAY_MIN_MS=1800
HUMAN_DELAY_MAX_MS=4200

# Follow-ups contados desde a última mensagem do cliente.
FOLLOWUP_2H_MINUTES=120
FOLLOWUP_24H_MINUTES=1440
FOLLOWUP_72H_MINUTES=4320
FOLLOWUP_CHECK_SECONDS=60

# Horário permitido para follow-ups no fuso abaixo.
TIMEZONE=America/Sao_Paulo
FOLLOWUP_START_HOUR=8
FOLLOWUP_END_HOUR=20
